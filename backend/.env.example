# Variables de entorno — Apurímac Turismo Backend
# Copia este archivo a .env y completa los valores reales

NODE_ENV=development
PORT=4000

# Simulación local: nunca procesa pagos y solo funciona en development.
PAYMENT_DEMO_ENABLED=false

# Reservado para la integración de Culqi en pruebas; no habilita cobros.
CULQI_TEST_ENABLED=false
CULQI_TEST_PUBLIC_KEY=
CULQI_TEST_SECRET_KEY=

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# Conexión MySQL — Formato Prisma
# Reemplaza USER, PASSWORD, HOST, DBNAME con tus valores reales
DATABASE_URL="mysql://root:TU_PASSWORD_MYSQL@localhost:3306/apurimac_turismo"

# JWT — Usa un secreto largo y aleatorio en producción
JWT_SECRET=cambia_esto_por_un_secreto_aleatorio_muy_largo_min_32_chars
JWT_EXPIRES_IN=7d

# Credenciales del administrador inicial (para el seed)
# NO uses estas credenciales en producción sin cambiarlas
ADMIN_SEED_EMAIL=admin@apurimac.pe
ADMIN_SEED_PASSWORD=CAMBIA_ESTA_CLAVE_POR_UNA_SEGURA
